# ============================================================================
#  Caddyfile — Reverse proxy con TLS automático (Let's Encrypt / ZeroSSL)
#
#  Uso en producción:
#    PUBLIC_DOMAIN=tienda.mi-dominio.com ACME_EMAIL=admin@mi.com \
#    docker compose -f docker-compose.prod.yml up -d
#
#  En local (docker-compose.prod.yml con PUBLIC_DOMAIN=localhost) Caddy sirve
#  en HTTP sin intentar obtener certificados.
# ============================================================================

{
    # Email para notificaciones de renovación de certificado.
    email {$ACME_EMAIL:admin@example.com}
}

# ─── Sitio principal ─────────────────────────────────────────────────────────
{$PUBLIC_DOMAIN:localhost} {

    # ── Correlación: id único por petición ───────────────────────────────────
    # Caddy genera un UUID y lo inyecta en la petición; reverse_proxy lo reenvía
    # a WordPress y a Next.js, que lo reutilizan y lo registran (X-Request-Id).
    # Permite seguir una misma petición a través de los tres logs.
    request_header X-Request-Id {http.request.uuid}

    # ── Cabeceras de seguridad base para TODA respuesta ───────────────────────
    # El frontend (next.config.mjs) ya manda estas mismas tres para sus propias
    # rutas; aquí se replican a nivel de Caddy porque /wp-admin/*, /wp-json/* y
    # /wp-content/* de abajo van DIRECTO a WordPress sin pasar por Next.js, así que
    # nunca las recibían. Mismo valor en ambos sitios (lo comprueba
    # tests/unit/caddyfile.test.ts): duplicarlas es inocuo. El prefijo `>` las aplica
    # al final, después del proxy, y pisa las del upstream.
    # HSTS no se condiciona a producción como hace next.config.mjs: los navegadores
    # ignoran la cabecera si no llega por TLS (RFC 6797), así que es inofensiva en
    # HTTP local.
    header >Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    header >X-Content-Type-Options "nosniff"
    header >Referrer-Policy "strict-origin-when-cross-origin"

    # ── WordPress: admin, login y webhooks REST ──────────────────────────────
    # Estos paths van directamente a WordPress. El BFF Next.js llama a
    # WordPress por la red interna Docker; aquí solo exponemos lo necesario.
    #
    # X-Frame-Options se declara en cada ruta de WordPress y NO arriba con las demás:
    # el frontend usa "DENY" para sí mismo, y WordPress no debe heredar ese valor más
    # estricto (rompería iframes propios de wp-admin, p. ej. la vista previa del
    # Customizer). "SAMEORIGIN" es lo que WP core ya manda en wp-login.php; aquí se
    # asegura también en el resto de rutas que el core no cubre (REST, medios).
    #
    # Panel en su propio host (opcional, `ADMIN_DOMAIN`): con la variable definida,
    # `/wp-admin` y el login de este dominio redirigen allí, para que un marcador
    # viejo no acabe en el 404 de Next. El sitio del panel está en
    # caddy/conf.d/admin.caddy (ver caddy/README.md). Sin la variable, la
    # expresión es falsa y todo sigue como antes.
    #
    # ⚠ El redirect y `siteurl` van EMPAREJADOS: con `siteurl` todavía en este
    # dominio, WordPress respondería al subdominio devolviendo aquí, y este
    # redirect lo mandaría de vuelta — bucle. Si hay que revertir, se revierten
    # los dos a la vez.
    @panel_moved {
        expression `"{$ADMIN_DOMAIN:}" != ""`
        path /wp-admin /wp-admin/* /wp-login.php /{$HWE_LOGIN_SLUG:wp-login.php}
    }
    handle @panel_moved {
        redir https://{$ADMIN_DOMAIN:}{uri} permanent
    }
    handle /wp-admin/* {
        header >X-Frame-Options "SAMEORIGIN"
        reverse_proxy wordpress:80
    }
    handle /wp-login.php {
        header >X-Frame-Options "SAMEORIGIN"
        reverse_proxy wordpress:80
    }
    # Login movido (HWE_LOGIN_SLUG, ver hwe-login-slug.php). Sin la variable, la ruta
    # cae en /wp-login.php y este bloque repite el anterior sin efecto.
    handle /{$HWE_LOGIN_SLUG:wp-login.php} {
        header >X-Frame-Options "SAMEORIGIN"
        reverse_proxy wordpress:80
    }
    handle /wp-cron.php {
        reverse_proxy wordpress:80
    }

    # API REST de WordPress: la usa el panel /wp-admin (editor de bloques, etc.).
    # Las rutas de COMERCIO no se exponen: el navegador debe pasar SIEMPRE por el
    # BFF (Origin + CSRF + rate-limit + sesión). Con /wp-json/wc/* abierto se podía
    # operar carrito y checkout (wc/store) saltándose esas barreras, y wc/v3 queda
    # a un paso de las claves de consumidor.
    #
    # El ORDEN importa: en Caddy gana el PRIMER `handle` que casa, así que estos dos
    # bloques deben ir antes del genérico /wp-json/*. El BFF no se ve afectado:
    # habla con WordPress por la red interna Docker (wordpress:80), no por Caddy.
    # (tests/unit/caddyfile.test.ts comprueba el orden.)
    handle /wp-json/wc/store/* {
        respond "Not Found" 404
    }
    handle /wp-json/wc/v3/* {
        respond "Not Found" 404
    }
    # El resto de /wp-json/* (wp/v2…) sigue accesible porque wp-admin lo requiere.
    # Para un endurecimiento mayor, restríngelo por IP de oficina o detrás de auth.
    handle /wp-json/* {
        header >X-Frame-Options "SAMEORIGIN"
        reverse_proxy wordpress:80
    }

    # GraphQL: el servidor Next.js lo consume por la RED INTERNA, no por aquí.
    # Exponerlo en público amplía superficie de ataque. Lo restringimos a
    # POST/OPTIONS (consultas legítimas) y bloqueamos GET (playground e
    # introspección por URL). Para HEADLESS PURO, puedes ELIMINAR este bloque
    # entero si ningún componente del navegador llama a GraphQL directamente.
    @graphql_ok {
        path /graphql
        method POST OPTIONS
    }
    handle @graphql_ok {
        reverse_proxy wordpress:80
    }
    # Cualquier otro método contra /graphql (GET, etc.) se rechaza.
    handle /graphql {
        respond "Method Not Allowed" 405
    }

    # Medios de WordPress: los sirve CADDY desde el disco, no Apache.
    #
    # Apache corre con MPM prefork y pocos workers (backend/config/apache-mpm.conf):
    # cada archivo que pasa por ahí ocupa uno de esos slots mientras dura, así que
    # un .jpg que se sirve en milisegundos puede esperar detrás de una consulta
    # GraphQL lenta. Es bloqueo de cabeza de línea, y se nota sobre todo en la
    # medioteca del panel. Caddy los sirve del mismo volumen (montado en solo
    # lectura, ver docker-compose.prod.yml), en paralelo y sin tocar PHP.
    #
    # Los .php bajo wp-content SÍ siguen yendo a Apache: algún plugin los usa como
    # endpoint, y servirlos como texto plano sería además una fuga de código.
    handle /wp-content/* {
        @php path *.php
        handle @php {
            reverse_proxy wordpress:80
        }
        handle {
            root * /var/www/html
            file_server
            header >Cache-Control "public, max-age=31536000, stale-while-revalidate=86400"
            header >X-Frame-Options "SAMEORIGIN"
        }
    }

    # ── Frontend (Next.js) ── todo lo demás ─────────────────────────────────
    # `lb_try_*`: durante el `up -d` del despliegue el contenedor viejo se para y
    # el nuevo tarda unos segundos en escuchar; sin reintento, Caddy respondía 502
    # al instante a quien llegara en ese hueco. Con él, la petición espera hasta
    # 30 s a que el upstream vuelva a aceptar conexiones. Solo se reintenta
    # cuando la CONEXIÓN falla —la petición no llegó a enviarse—, así que es
    # seguro también para un POST.
    handle {
        reverse_proxy frontend:3000 {
            lb_try_duration 30s
            lb_try_interval 250ms
        }
    }

    # Compresión de respuestas
    encode zstd gzip

    # Logging estructurado (JSON) hacia stdout → capturado por Docker logs
    log {
        output stdout
        format json
    }
}

# ─── Sitios opcionales ────────────────────────────────────────────────────────
# Cada archivo `*.caddy` de caddy/conf.d/ (montado en el contenedor) se importa
# aquí. Sin archivos, la expresión no casa con nada y Caddy lo acepta. Ver
# caddy/README.md (panel de WordPress en admin.<dominio>).
import /etc/caddy/conf.d/*.caddy

# ─── Redirección www → sin www ───────────────────────────────────────────────
www.{$PUBLIC_DOMAIN:localhost} {
    redir https://{$PUBLIC_DOMAIN}{uri} permanent
}
