{
  "$comment": "Frontera núcleo/instancia: fuente única. La leen ESLint (frontend/eslint.config.mjs, reglas con lint=true), tools/upgrade-check.mjs y los tests de frontera. Gana la PRIMERA regla que casa, así que las excepciones van antes que la regla general. owner: core (gana el framework al actualizar) | instance (gana lo local; el framework nunca lo toca) | gray (se revisa a mano). Una instancia añade sus reglas en tools/boundaries.local.json, que se evalúan antes que estas. Documentado en docs/UPGRADE.md §1.",
  "rules": [
    { "path": "tools/boundaries.local.json", "owner": "instance" },

    { "path": "frontend/src/app/api/instance/**", "owner": "instance" },
    { "path": "frontend/src/components/ui/**", "owner": "core", "lint": true },

    { "path": "backend/wp-content/mu-plugins/instance/**", "owner": "instance" },
    { "path": "backend/wp-content/plugins/hwe-instance-*/**", "owner": "instance" },
    { "path": "backend/scripts/instance.config.json", "owner": "instance" },
    { "path": "frontend/src/instance/**", "owner": "instance" },
    { "path": "frontend/tests/e2e/instance/**", "owner": "instance" },
    { "path": "frontend/src/components/**", "owner": "instance" },
    { "path": "frontend/src/app/[locale]/**", "owner": "instance" },
    { "path": "frontend/src/i18n/messages/**", "owner": "instance" },
    { "path": "PRODUCT.md", "owner": "instance" },
    { "path": "DESIGN.md", "owner": "instance" },
    { "path": "docker-compose.override.yml", "owner": "instance" },

    { "path": "frontend/package.json", "owner": "gray" },
    { "path": "frontend/package-lock.json", "owner": "gray" },
    { "path": "frontend/src/i18n/routing.ts", "owner": "gray" },
    { "path": ".gitignore", "owner": "gray" },
    { "path": "frontend/src/app/globals.css", "owner": "gray" },
    { "path": "frontend/src/app/icon.tsx", "owner": "gray" },
    { "path": "frontend/src/app/apple-icon.tsx", "owner": "gray" },
    { "path": "frontend/src/app/manifest.ts", "owner": "gray" },
    { "path": "frontend/public/**", "owner": "gray" },
    { "path": "brand/**", "owner": "gray" },
    { "path": "README.md", "owner": "gray" },

    { "path": "frontend/src/lib/**", "owner": "core", "lint": true },
    { "path": "frontend/src/app/api/**", "owner": "core", "lint": true },
    { "path": "frontend/src/proxy.ts", "owner": "core", "lint": true },
    { "path": "frontend/src/hooks/**", "owner": "core", "lint": true },
    { "path": "frontend/src/types/**", "owner": "core", "lint": true },
    { "path": "frontend/src/instrumentation*", "owner": "core" },
    { "path": "frontend/src/app/**", "owner": "core" },
    { "path": "frontend/src/i18n/**", "owner": "core" },
    { "path": "frontend/tests/**", "owner": "core" },
    { "path": "frontend/scripts/**", "owner": "core" },
    { "path": "frontend/.husky/**", "owner": "core" },
    { "path": "frontend/*", "owner": "core" },
    { "path": "backend/**", "owner": "core" },
    { "path": "contract/**", "owner": "core" },
    { "path": "tools/**", "owner": "core" },
    { "path": "docs/**", "owner": "core" },
    { "path": "examples/**", "owner": "core" },
    { "path": ".github/**", "owner": "core" },
    { "path": "caddy/**", "owner": "core" },
    { "path": "docker-compose.yml", "owner": "core" },
    { "path": "docker-compose.prod.yml", "owner": "core" },
    { "path": "docker-compose.override.example.yml", "owner": "core" },
    { "path": "Caddyfile", "owner": "core" },
    { "path": "FRAMEWORK_VERSION", "owner": "core" },
    { "path": "CHANGELOG.md", "owner": "core" },
    { "path": "*.md", "owner": "core" },
    { "path": "*", "owner": "core" }
  ]
}
