# ============================================================================
#  .env.prod — Variables de producción
#  Copia a `.env` (o nombre que prefieras) y completa TODOS los valores.
#  Nunca commitees este archivo con secretos reales.
#
#  Úsalo junto a docker-compose.prod.yml:
#      docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ============================================================================

# ── Compose: producción por defecto ───────────────────────────────────────────
# Sin `-f`, `docker compose --env-file .env.prod …` usa docker-compose.yml, el de
# DESARROLLO: recrea db y wordpress con otra configuración y publica puertos. Con esta
# línea, un `docker compose …` a secas en este directorio es el de producción (un `-f`
# explícito sigue mandando).
COMPOSE_FILE=docker-compose.prod.yml
# Volumen externo de la base de datos (se crea UNA vez con `docker volume create`). Si
# ya tenías una instalación: pon aquí el nombre de tu volumen actual (`docker volume ls`,
# suele ser `<directorio>_db_data`) en lugar de crear uno vacío.
HWE_DB_VOLUME=hwe_db_data
# Prefijo de los nombres de contenedor (`hwe_caddy`, `hwe_wordpress`…). Solo hace falta
# cambiarlo si esta pila de producción convive en el mismo daemon con otra (p. ej. una
# pila de desarrollo con los nombres por defecto).
# HWE_CONTAINER_PREFIX=hwe
# Proyecto de Compose (por defecto, el nombre de la carpeta). Debe ser único por pila.
# COMPOSE_PROJECT_NAME=mi-tienda

# ── Dominio público y HTTPS (Let's Encrypt) ──────────────────────────────────
PUBLIC_DOMAIN=tienda.mi-dominio.com
ACME_EMAIL=admin@mi-dominio.com

# ── Base de datos ─────────────────────────────────────────────────────────────
# ⚠ Usa contraseñas largas y aleatorias en producción.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CAMBIA_ESTO_contraseña_larga
MYSQL_ROOT_PASSWORD=CAMBIA_ESTO_root_contraseña_larga

# ── WordPress ─────────────────────────────────────────────────────────────────
WORDPRESS_DEBUG=0
WP_ENVIRONMENT_TYPE=production
WORDPRESS_PUBLIC_URL=https://tienda.mi-dominio.com
HEADLESS_FRONTEND_URL=https://tienda.mi-dominio.com
# URL del frontend para llamadas servidor a servidor dentro de la red del compose. Por
# defecto `http://frontend:3000` (nombre del servicio); la pública también llegaría por
# Caddy, pero exige resolver el dominio y salir por el ingress. Vacía = se usa la pública.
#HEADLESS_FRONTEND_INTERNAL_URL=http://frontend:3000
HEADLESS_ALLOWED_ORIGINS=https://tienda.mi-dominio.com
WP_TITLE=Mi Tienda
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=CAMBIA_ESTO_admin_pass
WP_ADMIN_EMAIL=admin@mi-dominio.com
# Login del panel en /<slug> en lugar de /wp-login.php (que pasa a responder 404).
# 6–63 caracteres [a-z0-9-]. Vacío = sin mover: el login sigue en /wp-login.php.
# Fuera de este compose, omite la variable (o pon wp-login.php) en el entorno de
# Caddy cuando no quieras mover el login. No lo publiques.
HWE_LOGIN_SLUG=

# IPs (separadas por espacios o comas; exactas, sin CIDR) que pueden llegar a GraphQL como
# integración externa (módulo `external-integration`: ERP, logística). Vacío = nadie. Solo
# GraphQL, y solo con la contraseña de aplicación del usuario de servicio: la Store API y
# `hwe/v1/auth|consent` siguen cerradas. Ver backend/wp-content/plugins/hwe-external-integration/MANUAL.md.
HWE_INTEGRATION_ALLOWED_IPS=

# ── Seguridad / Autenticación ─────────────────────────────────────────────────
# Genera: openssl rand -base64 64
GRAPHQL_JWT_AUTH_SECRET_KEY=CAMBIA_ESTO_clave_jwt_muy_larga
# Genera: openssl rand -base64 32
# OBLIGATORIO y sin valor de reserva: sin él, ninguna escritura del BFF funciona.
# (ALLOWED_ORIGIN lo deriva docker-compose.prod.yml de PUBLIC_DOMAIN como https://<dominio>.)
CSRF_SECRET=CAMBIA_ESTO_csrf_secret

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tienda.mi-dominio.com
# (Ya no existe NEXT_PUBLIC_WORDPRESS_API_URL: el navegador no habla con WordPress. El servidor
# Next lo alcanza por la red interna de Docker y se identifica con HWE_REVALIDATION_SECRET.)
# Origen público de WordPress, solo para autorizar sus imágenes (CSP + next/image). Va en el
# BUILD de la imagen del frontend (next.config.mjs se evalúa al construir).
# WORDPRESS_PUBLIC_URL=https://tienda.mi-dominio.com
# Imagen del frontend construida para producción (toma de aquí los build-args):
#   docker compose -f docker-compose.prod.yml --env-file .env.prod build frontend
FRONTEND_IMAGE=hwe-frontend:prod

# ── Panel de WordPress en su propio host (opcional) ───────────────────────────
# Con valor, /wp-admin y el login del dominio público redirigen a este host. Ver
# caddy/README.md (DNS, `caddy/conf.d/admin.caddy`, `siteurl`).
# ADMIN_DOMAIN=admin.tienda.mi-dominio.com

# ── Caché de Next ─────────────────────────────────────────────────────────────
# Días sin uso tras los que `cache-prune` borra una variante de imagen optimizada
# (`/app/.next/cache/images`). El resto de la caché (ISR) no se toca nunca.
# CACHE_IMAGES_MAX_AGE_DAYS=30

# ── MariaDB ───────────────────────────────────────────────────────────────────
# ≈ 50 % del límite de memoria del servicio `db` (512m por defecto).
# MYSQL_INNODB_BUFFER_POOL_SIZE=256M
# MYSQL_MAX_CONNECTIONS=50

# ── Indexación ────────────────────────────────────────────────────────────────
# Staging / preproducción: `true` saca el sitio entero de los buscadores
# (robots.txt `Disallow: /` y cabecera X-Robots-Tag: noindex en cada página).
# Se lee en ejecución: la misma imagen sirve para staging y producción.
# En PRODUCCIÓN déjala vacía.
# HWE_NOINDEX=
# IndexNow (Bing, Yandex, Naver, Seznam; Google no lo usa): cada cambio de
# producto se anuncia al momento. Clave de 8–128 caracteres [a-zA-Z0-9-], que
# se publica en /indexnow.txt. Vacía = apagado. Generar: openssl rand -hex 16
# INDEXNOW_KEY=

# ── Build y rendimiento del frontend (todas opcionales) ───────────────────────
# Lo que el build CONGELA (CSP, remotePatterns): por defecto, el dominio público.
# WORDPRESS_PUBLIC_URL=https://tienda.mi-dominio.com
# CSP_ANALYTICS_PROVIDERS=
# SENTRY_DSN=
# DSN público del cliente (si falta, se usa SENTRY_DSN) y replay opt-in.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_REPLAY=false
# Cola larga del prerender: `all` (por defecto) o `none` (ISR bajo demanda).
# PRERENDER_LONG_TAIL=all
# Paciencia y ritmo SOLO del build, con WordPress cargado por el propio build.
# BUILD_GRAPHQL_TIMEOUT_MS=60000
# BUILD_CONFIG_TIMEOUT_MS=30000
# BUILD_STATIC_PAGE_TIMEOUT=180
# BUILD_STATIC_MAX_CONCURRENCY=2
# BUILD_STATIC_MIN_PAGES_PER_WORKER=400
# Paciencia EN RUNTIME: una petición abortada por plazo no entra en el Data Cache y
# convierte la lentitud de WordPress en una cascada de 500.
# RUNTIME_GRAPHQL_TIMEOUT_MS=25000
# RUNTIME_CONFIG_TIMEOUT_MS=15000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── WooCommerce ───────────────────────────────────────────────────────────────
WC_API_URL=http://wordpress:80/wp-json/wc/v3
WC_STORE_API_URL=http://wordpress:80/wp-json/wc/store/v1
# Genera con: docker compose run --rm --entrypoint /bin/sh wpcli /scripts/generate-woo-keys.sh
WC_CONSUMER_KEY=ck_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WC_CONSUMER_SECRET=cs_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Genera: openssl rand -hex 32
WC_WEBHOOK_SECRET=CAMBIA_ESTO_webhook_secret

# ── HWE Control Center ────────────────────────────────────────────────────────
# Secreto compartido WordPress ↔ BFF: firma la revalidación y es el SECRETO INTERNO que el BFF
# envía (X-HWE-Internal-Secret) en todas sus llamadas a WordPress; sin él, el mu-plugin
# `hwe-bff-only` responde 404 a GraphQL, la Store API y hwe/v1/auth|consent.
# Genera: openssl rand -hex 32
HWE_REVALIDATION_SECRET=CAMBIA_ESTO_hwe_revalidation_secret

# Claves AES dedicadas (AES-256-GCM) para cifrar en reposo los secretos del
# Control Center y los secretos TOTP de 2FA. DEBEN ser estables: si cambian,
# los datos cifrados existentes quedan indescifrables. En producción son
# OBLIGATORIAS (el core de WP no se persiste, no hay AUTH_KEY estable de fallback).
# Genera cada una con: openssl rand -base64 32
HWE_SECRETS_KEY=CAMBIA_ESTO_clave_secrets_aes
HWE_2FA_KEY=CAMBIA_ESTO_clave_2fa_aes

# ── Pagos ─────────────────────────────────────────────────────────────────────
# Pasarela de cobro REAL: `wompi` | `avalpay` | `payu` | `bold` …
# `noop` es la pasarela de PRUEBAS y firma con un secreto publicado: en
# producción el arranque la rechaza. Sin pasarela decidida, el cobro responde
# 503 y su webhook 404 (no hay cobro en línea hasta configurar una).
# Ejemplo: PAYMENT_PROVIDER=wompi
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=EUR
NEXT_PUBLIC_PAYMENT_RETURN_URL=https://tienda.mi-dominio.com/checkout/return
# Secreto del sandbox `noop` (solo desarrollo/test). En producción no se usa:
# déjalo vacío y nunca pongas el literal público del repositorio.
# NOOP_INTEGRITY_SECRET=

# ── Backups ───────────────────────────────────────────────────────────────────
# Días de retención local (sincroniza a S3/rclone para retención larga).
BACKUP_RETAIN_DAYS=30
# Hora UTC (0-23) de la copia programada. El panel («Backups») puede sobrescribirla.
BACKUP_HOUR_UTC=3
# Minutos tras los que un lock de copia huérfano (OOM, `docker kill`) se da por muerto y se
# retira; sin esto una copia que muere deja al sitio sin copias hasta intervenir. Por encima
# de lo que tarda tu copia más larga.
HWE_BACKUP_LOCK_MAX_AGE_MIN=360
