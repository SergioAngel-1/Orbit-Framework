{
  "name": "hwe-frontend",
  "version": "2.0.0",
  "author": "Sergio Jauregui",
  "private": true,
  "description": "Frontend Next.js (App Router) y BFF de HWE Orbit",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:gate": "node scripts/audit-gate.mjs",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "postinstall": "node scripts/patch-next-isr-headers.mjs",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "og:generate": "node scripts/generate-og-images.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.76.2",
    "@swc/helpers": "^0.5.23",
    "country-flag-icons": "^1.6.20",
    "ioredis": "5.11.1",
    "isomorphic-dompurify": "^3.23.0",
    "jose": "^6.2.12",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "otplib": "^13.4.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.4",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@sentry/cli@2.58.6": true,
    "unrs-resolver@1.12.2": true
  }
}
