# ============================================================================
#  Headless Web Ecosystem — .gitignore
#  Estructura: /backend (WordPress) + /frontend (Next.js) + Docker
# ============================================================================

# ---------- Entornos ----------
# El patrón ".env" es una coincidencia EXACTA de ese nombre: no cubre ".env.prod", justo el
# que docker-compose.prod.yml y .env.prod.example mandan crear con TODOS los secretos de
# producción. Va listado explícitamente. Las plantillas `*.example` siguen versionadas.
.env
.env.prod
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
!**/.env.example

# Config de marca/diseño de la instancia (wp hwe setup) — solo se versiona la plantilla
backend/scripts/instance.config.json
!backend/scripts/instance.config.example.json

# Notas de trabajo sobre la instancia de origen: se llevan aparte, fuera del repositorio.
docs/superpowers/hallazgos-*.md

# ---------- Secretos / claves ----------
*.pem
*.key
*.cert
*.ppk
SitegroundAccess/

# ============================================================================
#  BACKEND — WordPress
# ============================================================================
# Solo versionamos nuestro código propio (mu-plugins, config, scripts).
# Todo lo que WordPress descarga/genera se ignora.
backend/wp-content/plugins/*
backend/wp-content/themes/*
backend/wp-content/upgrade/
backend/wp-content/uploads/*
!backend/wp-content/uploads/.gitkeep
backend/wp-content/cache/
backend/wp-content/languages/
backend/wp-content/advanced-cache.php
backend/wp-content/object-cache.php
backend/wp-content/db.php
backend/wp-content/hwe-backup-config.json

# Mantén nuestro mu-plugin headless versionado
!backend/wp-content/mu-plugins/
!backend/wp-content/mu-plugins/**

# ── Contrato de instancia ────────────────────────────────────────────────────
# `mu-plugins/instance/` es el código de LA INSTANCIA: el framework nunca lo toca, así que
# solo versiona el README (que explica el contrato). Debe ir DESPUÉS del `!mu-plugins/**` de
# arriba: en .gitignore gana la última regla que casa.
# Una instancia clonada quiere versionar su propio código: borra estas dos líneas.
backend/wp-content/mu-plugins/instance/*
!backend/wp-content/mu-plugins/instance/README.md

# Plugins grandes de la instancia (`hwe-instance-<slug>`, p. ej. un CPT con tablas propias).
# Los plugins ya están ignorados por defecto (`plugins/*`); una instancia descomenta estas dos
# líneas para versionar los suyos.
# !backend/wp-content/plugins/hwe-instance-*/
# !backend/wp-content/plugins/hwe-instance-*/**

# Mantén versionados los módulos del framework (plugins regulares, código propio): uno por id
# del catálogo de `Modules::CORE_IDS`. Los de una instancia son `hwe-instance-*` (arriba).
!backend/wp-content/plugins/
!backend/wp-content/plugins/hwe-banners/
!backend/wp-content/plugins/hwe-banners/**
!backend/wp-content/plugins/hwe-shipping/
!backend/wp-content/plugins/hwe-shipping/**
!backend/wp-content/plugins/hwe-product-landing/
!backend/wp-content/plugins/hwe-product-landing/**
!backend/wp-content/plugins/hwe-landings/
!backend/wp-content/plugins/hwe-landings/**
!backend/wp-content/plugins/hwe-consent-log/
!backend/wp-content/plugins/hwe-consent-log/**
!backend/wp-content/plugins/hwe-site-reviews/
!backend/wp-content/plugins/hwe-site-reviews/**
!backend/wp-content/plugins/hwe-coupon-rules/
!backend/wp-content/plugins/hwe-coupon-rules/**
!backend/wp-content/plugins/hwe-customer-identity/
!backend/wp-content/plugins/hwe-customer-identity/**
!backend/wp-content/plugins/hwe-external-integration/
!backend/wp-content/plugins/hwe-external-integration/**

# Mantén el tema base del framework versionado (headless: no renderiza nada
# público, solo evita depender de un tema de wordpress.org — ver setup.sh).
!backend/wp-content/themes/hwe-headless-base/
!backend/wp-content/themes/hwe-headless-base/**

# Tests PHP (PHPUnit + Brain Monkey): dependencias y cachés locales.
# composer.lock SÍ se versiona (CI instala exactamente lo mismo).
backend/vendor/
backend/.phpunit.cache/
backend/.phpunit.result.cache

# ============================================================================
#  FRONTEND — Next.js
# ============================================================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.vercel
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Tests / cobertura / Playwright (Fase 8)
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/.playwright/

# ============================================================================
#  Bases de datos / dumps
# ============================================================================
*.sql
*.sql.gz
*.sqlite
*.db
*.dump
# Salida de backup.sh / backup-cron.sh (uploads-*.tar.gz) y el directorio destino por
# defecto de backup.sh (que docker-compose.prod.yml monta como ./backups en el
# contenedor `backup`). Los volcados *.sql.gz ya estaban cubiertos; los medios no.
*.tar.gz
/backups/

# ============================================================================
#  Logs
# ============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log
error_log

# ============================================================================
#  Sistema operativo
# ============================================================================
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================================
#  IDE / Editores
# ============================================================================
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.code-workspace
*.sublime-project
*.sublime-workspace

# ============================================================================
#  Claude Code
# ============================================================================
.claude/
*.claude-session

# ============================================================================
#  Temporales
# ============================================================================
*.tmp
*.temp
*.swp
*.bak
*.cache
